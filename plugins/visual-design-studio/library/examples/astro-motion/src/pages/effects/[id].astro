import Base from '../../layouts/Base.astro';import EffectStage from '../../components/EffectStage.vue';import {effects} from '../../lib/catalog.mjs';
export function getStaticPaths(){return effects.map(effect=>({params:{id:effect.id},props:{effect}}));}
const {effect}=Astro.props;const i=effects.findIndex(e=>e.id===effect.id),next=effects[(i+1)%effects.length];
---
<Base title={effect.name}><section class="pt-12 pb-8"><a href="/#catalog" class="text-sm text-muted">← All studies</a><div class="flex gap-2 mt-8"><span class="pill">{effect.tier}</span><span class="pill">{effect.engine}</span><span class="pill">{effect.status==='implemented'?'Live study':'Researched recipe'}</span></div><h1 class="text-5xl md:text-7xl tracking-tight mt-5">{effect.name}</h1><p class="text-lg text-muted mt-5 max-w-2xl">{effect.purpose}</p></section><div class="grid lg:grid-cols-[2fr_1fr] gap-10"><div><EffectStage id={effect.id} client:load/><noscript><p class="fixture mt-4">Motion preview controls require JavaScript. The initial specimen and recipe remain available.</p></noscript><div class="mt-8 border-t border-line pt-5 flex flex-wrap gap-3 justify-between"><p class="text-sm text-muted">Static first. Motion is an enhancement.</p><a href={`/effects/${next.id}/`} class="text-sm">Next: {next.name} →</a></div></div><aside class="space-y-7 text-sm leading-relaxed"><section><h2 class="eyebrow mb-3">Use it when</h2><p>{effect.use}</p></section><section><h2 class="eyebrow mb-3">Implementation</h2><p>{effect.recipe}</p>{effect.component&&<code class="block mt-3 break-all text-xs">src/components/effects/{effect.component}.vue</code>}</section><section><h2 class="eyebrow mb-3">Fallback</h2><p>{effect.fallback}</p></section><section><h2 class="eyebrow mb-3">Verify</h2><p>{effect.verify}</p></section><section><h2 class="eyebrow mb-3">Primary source</h2><a href={effect.source} target="_blank" rel="noopener noreferrer">Read the documentation ↗</a></section></aside></div></Base>
