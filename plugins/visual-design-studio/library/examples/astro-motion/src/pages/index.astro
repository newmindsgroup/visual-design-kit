---
// Version-Timestamp: 2026-10-14 11:06:44 AST
import Base from '../layouts/Base.astro';import {effects} from '../lib/catalog.mjs';
const live=effects.filter(e=>e.status==='implemented').length;
---
<Base title="Motion with a purpose"><section class="pt-16 md:pt-24 pb-16 grid md:grid-cols-[2fr_1fr] gap-10"><div><p class="eyebrow mb-6">A coded specimen collection</p><h1 class="text-6xl md:text-8xl tracking-[-.06em] leading-[.98] max-w-3xl">Motion with<br/>a purpose<span class="text-accent">.</span></h1><p class="text-lg text-muted max-w-xl mt-8 leading-relaxed">From a small change of state to an expressive scroll story. Find a pattern, play the study, then adapt the code to the work.</p></div><div class="self-end border-l border-line pl-6 md:pl-10"><div class="flex gap-10 mb-6"><div><span class="block text-4xl">{live}</span><span class="text-sm text-muted">working studies</span></div><div><span class="block text-4xl">{effects.length-live}</span><span class="text-sm text-muted">researched recipes</span></div></div><p class="text-sm text-muted leading-relaxed">Everyday patterns keep interfaces clear. Experimental studies add depth and character when the project calls for it.</p></div></section><section id="catalog"><div class="border-y border-line py-5 flex flex-wrap justify-between gap-4"><h2 class="text-xl font-medium">The collection</h2><div class="flex flex-wrap gap-3"><label class="sr-only" for="search">Search studies</label><input id="search" type="search" placeholder="Search a technique" class="border border-line rounded-full px-4 py-2 bg-transparent text-sm"/><label class="sr-only" for="tier">Filter by tier</label><select id="tier" class="border border-line rounded-full px-4 py-2 bg-transparent text-sm"><option value="all">All tiers</option><option value="everyday">Everyday</option><option value="experimental">Experimental</option></select></div></div><p id="results" role="status" class="text-sm text-muted py-4">{effects.length} studies</p><div class="grid md:grid-cols-2 gap-x-10">{effects.map((effect,i)=><a href={`/effects/${effect.id}/`} data-effect-row data-tier={effect.tier} data-search={`${effect.name} ${effect.family} ${effect.engine}`.toLowerCase()} class="group no-underline py-7 border-b border-line grid grid-cols-[2rem_1fr_auto] gap-4"><span class="eyebrow pt-1">{String(i+1).padStart(2,'0')}</span><div><h3 class="text-xl group-hover:underline underline-offset-4">{effect.name}</h3><p class="text-sm text-muted mt-2 leading-relaxed">{effect.purpose}</p><div class="flex gap-2 mt-4"><span class="pill">{effect.tier}</span><span class="pill">{effect.status==='implemented'?'Live study':'Recipe'}</span></div></div><span aria-hidden="true" class="self-start text-xl">↗</span></a>)}</div><p id="empty" hidden class="py-12 text-muted">No matching study. Try a broader search or choose all tiers.</p></section></Base>
<script>
// Version-Timestamp: 2026-10-14 11:06:44 AST
let cleanup:(()=>void)|undefined;
function mount(){cleanup?.();const search=document.querySelector<HTMLInputElement>('#search'),tier=document.querySelector<HTMLSelectElement>('#tier');if(!search||!tier)return;const update=()=>{let count=0;document.querySelectorAll<HTMLElement>('[data-effect-row]').forEach(row=>{const visible=(!search.value||row.dataset.search?.includes(search.value.toLowerCase()))&&(tier.value==='all'||row.dataset.tier===tier.value);row.hidden=!visible;if(visible)count++});const results=document.querySelector('#results');if(results)results.textContent=`${count} studies`;const empty=document.querySelector<HTMLElement>('#empty');if(empty)empty.hidden=count>0;};search.addEventListener('input',update);tier.addEventListener('change',update);cleanup=()=>{search.removeEventListener('input',update);tier.removeEventListener('change',update)};update();}
document.addEventListener('astro:page-load',mount);document.addEventListener('astro:before-swap',()=>cleanup?.());
</script>
