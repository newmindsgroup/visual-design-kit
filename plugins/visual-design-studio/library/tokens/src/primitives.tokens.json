{
  "$description": "Primitive tier: raw OKLCH ramps and scales. Components never reference these directly; semantic tokens do. color.neutral, color.accent and font.family are the brand-level groups that brands/*.tokens.json remap.",
  "$extensions": {
    "com.github.newmindsgroup.vdk": {
      "brand": "meridian",
      "brandName": "Meridian"
    }
  },
  "color": {
    "$type": "color",
    "$description": "Ramps are generated by scripts/color_tools.py from the recipe in each group's $extensions: OKLab lightness is linear in the step number (L = 1.02 - 0.0009 x step, so step 50 = 0.975 and 950 = 0.165), chroma tapers toward both ends, and out-of-gamut colors are mapped into sRGB by reducing chroma. The same step has the same lightness in every ramp, so swapping a brand's hue keeps contrast close. Regenerate with tokens.py ramps --write.",
    "white": {
      "$value": "#ffffff",
      "$description": "Pure white. Light surfaces and text on accent fills."
    },
    "black": {
      "$value": "#000000",
      "$description": "Pure black. Reserved for shadows and scrims; never a dark-mode canvas."
    },
    "slate": {
