{
  "$description": "Light mode (default). Tinted neutral canvas, white surfaces, accent at step 600 with white text.",
  "$extensions": {
    "com.github.newmindsgroup.vdk": {
      "name": "Light",
      "colorScheme": "light"
    }
  },
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "{color.neutral.50}",
        "$description": "Page background behind everything."
      },
      "surface": {
        "$value": "{color.white}",
        "$description": "Default container: cards, panels, table rows, inputs."
      },
      "surface-raised": {
        "$value": "{color.white}",
        "$description": "Floating layers: menus, popovers, dialogs, toasts. In dark mode it is lighter than surface (elevation reads as lightness)."
      },
      "sunken": {
        "$value": "{color.neutral.100}",
        "$description": "Recessed wells: code blocks, table headers, disabled inputs, progress tracks."
      },
      "inverse": {
        "$value": "{color.neutral.900}",
        "$description": "Inverted surfaces: tooltips, snackbars."
      }
    },
    "fg": {
      "default": {
        "$value": "{color.neutral.900}",
        "$description": "Body text, headings, icons with meaning."
      },
      "muted": {
        "$value": "{color.neutral.600}",
        "$description": "Secondary text: captions, metadata, helper text. Still 4.5:1 (7:1 in high contrast)."
      },
      "subtle": {
        "$value": "{color.neutral.500}",
        "$description": "Placeholders and non-essential text only (3:1). Never for information the user needs."
      },
      "inverse": {
        "$value": "{color.neutral.50}",
        "$description": "Text on bg-inverse."
      },
      "on-accent": {
        "$value": "{color.white}",
        "$description": "Text and icons on accent-default, accent-hover and accent-active fills."
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.neutral.100}",
        "$description": "Decorative dividers and card outlines (no contrast requirement)."
      },
      "default": {
        "$value": "{color.neutral.200}",
        "$description": "Component borders where the border is not the only cue."
      },
      "strong": {
        "$value": "{color.neutral.500}",
        "$description": "Borders that identify a control (inputs, checkboxes, radio rings): 3:1 on canvas, WCAG 1.4.11."
      }
    },
    "accent": {
      "default": {
        "$value": "{color.accent.600}",
        "$description": "Primary action fill, selected and checked states, brand moments. Scarce: one primary per view."
      },
      "hover": {
        "$value": "{color.accent.700}",
        "$description": "Hover on accent fills."
      },
      "active": {
        "$value": "{color.accent.800}",
        "$description": "Pressed accent fills."
      },
      "subtle": {
        "$value": "{color.accent.100}",
        "$description": "Tinted background: selected rows, accent badges, highlighted callouts."
      },
      "fg": {
        "$value": "{color.accent.700}",
        "$description": "Accent text and icons: links, active navigation. 4.5:1 on canvas, surface and accent-subtle."
      }
    },
    "success": {
      "fg": {
        "$value": "{color.green.700}",
        "$description": "Success text and icons; 4.5:1 on Success-bg, canvas and surface."
      },
      "bg": {
        "$value": "{color.green.100}",
        "$description": "Success alert and badge background."
      },
      "border": {
        "$value": "{color.green.300}",
        "$description": "Success alert and badge border (decorative)."
      }
    },
    "warning": {
      "fg": {
        "$value": "{color.amber.700}",
        "$description": "Warning text and icons; 4.5:1 on Warning-bg, canvas and surface."
      },
      "bg": {
        "$value": "{color.amber.100}",
        "$description": "Warning alert and badge background."
      },
      "border": {
        "$value": "{color.amber.300}",
        "$description": "Warning alert and badge border (decorative)."
      }
    },
    "danger": {
      "fg": {
        "$value": "{color.red.700}",
        "$description": "Danger text and icons; 4.5:1 on Danger-bg, canvas and surface."
      },
      "bg": {
        "$value": "{color.red.100}",
        "$description": "Danger alert and badge background."
      },
      "border": {
        "$value": "{color.red.300}",
        "$description": "Danger alert and badge border (decorative)."
      }
    },
    "info": {
      "fg": {
        "$value": "{color.blue.700}",
        "$description": "Info text and icons; 4.5:1 on Info-bg, canvas and surface."
      },
      "bg": {
        "$value": "{color.blue.100}",
        "$description": "Info alert and badge background."
      },
      "border": {
        "$value": "{color.blue.300}",
        "$description": "Info alert and badge border (decorative)."
      }
    },
    "focus-ring": {
      "$value": "{color.accent.600}",
      "$description": "Focus outline (2px, offset 2px): 3:1 against canvas, surface and raised surfaces."
    },
    "overlay-scrim": {
      "$value": "{color.alpha.black-48}",
      "$description": "Modal backdrop."
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Elevation. Pair with surface-raised; in dark mode lightness carries elevation and shadows only separate edges.",
    "sm": {
      "$value": [
        {
          "color": "{color.alpha.black-8}",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
      ]
    },
    "md": {
      "$value": [
        {
          "color": "{color.alpha.black-4}",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        },
        {
          "color": "{color.alpha.black-8}",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "8px",
          "spread": "-2px"
        }
      ]
    },
    "lg": {
      "$value": [
        {
          "color": "{color.alpha.black-4}",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "-1px"
        },
        {
          "color": "{color.alpha.black-12}",
          "offsetX": "0px",
          "offsetY": "12px",
          "blur": "24px",
          "spread": "-6px"
        }
      ]
    },
    "xl": {
      "$value": [
        {
          "color": "{color.alpha.black-8}",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "8px",
          "spread": "-2px"
        },
        {
          "color": "{color.alpha.black-16}",
          "offsetX": "0px",
          "offsetY": "24px",
          "blur": "48px",
          "spread": "-12px"
        }
      ]
    }
  }
}
